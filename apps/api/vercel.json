{
  "version": 2,
  "buildCommand": "npm run build",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 3009,
      "includeFiles": "node_modules/playwright-core/**,node_modules/@sparticuz/chromium-min/**"
    }
  }
}
