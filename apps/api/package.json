{
  "name": "@bmo/api",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --external:react-native --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@p-stream/providers": "file:./vendor/p-stream-providers",
    "cheerio": "1.0.0-rc.12",
    "cookie": "^0.6.0",
    "crypto-js": "^4.2.0",
    "elysia": "^1.2.0",
    "form-data": "^4.0.4",
    "fuse.js": "^7.1.0",
    "hls-parser": "^0.13.6",
    "iso-639-1": "^3.1.5",
    "json5": "^2.2.3",
    "nanoid": "^3.3.11",
    "set-cookie-parser": "^2.7.1",
    "unpacker": "^1.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0"
  }
}
