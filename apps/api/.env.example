# TMDB API Key (v3 auth) — sácala en https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Proxy para el resolver de streams (Cloudflare Worker de @movie-web/simple-proxy).
# Sin esto, la mayoría de proveedores fallan por bloqueos SSL/CORS/IP.
# Despliega: https://github.com/movie-web/simple-proxy  (gratis en CF Workers)
# Ej: STREAM_PROXY_URL=https://tu-proxy.tu-usuario.workers.dev
STREAM_PROXY_URL=
